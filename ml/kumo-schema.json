        "vendor": {
          "dtype": "string",
          "stype": "categorical",
          "nullable": false,
          "description": "Sales rep who handled the lead"
        }
      },
      "primary_key": "lead_id"
    },
    "related_tables": {
      "interactions": {
        "name": "interactions",
