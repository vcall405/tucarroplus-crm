          "lead_id": {
            "dtype": "int64",
            "stype": "ID",
            "nullable": false
          },
          "interaction_date": {
            "dtype": "timestamp[us]",
            "stype": "timestamp",
            "nullable": false
          },
          "status_change": {
            "dtype": "string",
            "stype": "categorical",
            "nullable": false,
            "description": "nuevo → contactado → cita → negociando → vendido"
