        "created_at": {
          "dtype": "timestamp[us]",
          "stype": "timestamp",
          "nullable": false
        },
        "converted": {
          "dtype": "bool",
          "stype": "categorical",
          "description": "1 if status=vendido, 0 if perdido/dropped"
        },
        "days_to_close": {
          "dtype": "int32",
          "stype": "numerical",
          "nullable": true,
          "description": "Days from creation to vendido/perdido"
