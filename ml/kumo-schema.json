{
  "model": "kumo-relational",
  "task": {
    "kind": "binary_classification",
    "target": {
      "column_name": "converted",
      "dtype": "bool",
      "classes": ["false", "true"],
      "positive_class": "true"
    },
    "entity_table_names": ["interactions", "vehicles_viewed", "lead_context"],
    "anchor_time_column": "created_at"
  },
  "schema": {
