{
  "name": "tucarroplus-crm",
  "version": "1.0.0",
  "description": "AI-powered CRM for automotive dealerships + NVIDIA Kumo ML predictions",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node --watch server.js",
    "client:dev": "vite --host 0.0.0.0",
    "start": "node server.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "import:leads": "node scripts/import-leads.js",
    "score:leads": "node scripts/score-leads.js",
    "kumo:predict": "node ml/predictions.js",
    "kumo:train": "node ml/data-transform.js",
    "export": "node scripts/export-training-data.js",
    "test": "node --test tests"
  },
  "keywords": [
    "crm",
    "automotive",
    "ml",
    "kumo",
    "predictions",
    "lead-scoring"
  ],
  "author": "Miguel Fuentes",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vitejs/plugin-react": "^5.0.2",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "firebase-admin": "^12.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1"
  },
  "engines": {
    "node": ">=22"
  }
}
