# Firebase (Firestore Database)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# NVIDIA Kumo API
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_API_URL=https://ai.api.nvidia.com/v1/structured-data/nvidia/kumo-relational/predictions

# n8n Integration (optional)
N8N_WEBHOOK_URL=https://n8n2.vcallia.com/webhook/tucarroplus-crm
N8N_API_KEY=your_n8n_api_key

# App Settings
PORT=3000
NODE_ENV=development
CRM_NAME=Tucarroplus CRM
VENDOR_DEFAULT=Miguel
